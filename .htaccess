# Prevent search engine indexing and archiving
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

# Block search engine crawlers, AI scrapers, and automated bots (Exclude API endpoints and GAS sync)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{HTTP_USER_AGENT} !Google-Apps-Script [NC]
    RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|exabot|facebot|ia_archiver|mj12bot|ahrefsbot|semrushbot|dotbot|petalbot|bytespider|gptbot|chatgpt-user|claudebot|claude-web|perplexitybot|applebot|ccbot|twitterbot|facebookexternalhit|rogerbot|linkedinbot|embedly|slackbot|scrapy|curl|wget|python|urllib|libwww|httpclient|go-http-client|java) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# Prevent browser caching of HTML files so users always load latest code
<FilesMatch "\.(html|htm|php)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

# Access-Control-Allow-Origin
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

